    "censored_wind_power.benchmark.censored_qr"
  ],
  "scenarios": [
    "S6_realistic"
  ],
  "models": [
    "B0_persistence",
    "B0_climatology",
    "B1",
    "B4",
    "B6",
    "BQR",
    "CLQR",
    "ORACLE"
  ],
  "model_settings": {},
