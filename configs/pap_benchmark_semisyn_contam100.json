{
  "schema_version": 2,
  "output_dir": "results/pap_benchmark_semisyn_contam100",
  "model_modules": [
    "censored_wind_power.benchmark.tobit",
    "censored_wind_power.benchmark.powercurve",
    "censored_wind_power.benchmark.censored_qr"
  ],
  "scenarios": [
    "S1_fixed_50pct",
    "S2_fixed_70pct",
    "S3_fixed_85pct",
    "S4_random_uniform",
    "S5_wind_triggered"
  ],
  "models": [
    "B0_persistence",
    "B0_climatology",
    "B1",
    "B2_recon",
    "B4_plain",
    "B4",
    "B6",
    "BQR",
    "CLQR",
    "BT",
    "ORACLE"
  ],
  "model_settings": {
    "BT": {
      "sigma_floor": 0.001
    },
    "B2_recon": {
      "bin_width_ms": 0.5,
      "min_bin_count": 30
    }
  },
  "seeds": [42, 123, 256, 789, 1024],
  "data": {
    "directory": "results/altahullion_audit",
    "filename_pattern": "synthetic_{scenario}.parquet",
    "rated_power_kw": 1330.0,
    "sampling_interval_minutes": 1
  },
  "contamination": {
    "enabled": true,
    "channel": "wind",
    "trigger": "is_censored",
    "mode": "relative",
    "relative_delta": 0.167,
    "intensity_factor": 1.0,
    "schedule_bins_ms": [0, 6, 7, 8, 9, 10, 12, 99],
    "measurement_provenance": "scripts/12_measure_censoring_contamination.py; ALTA2 5-turbine paired difference-in-differences on real curtailment segments; +16.7% relative, 95% CI [13.2%, 20.6%]; 10-min basis applied to 1-min data (mean shift only, no variance change)",
    "notes": "schedule_bins_ms is used only as audit band edges in relative mode; the injected offset is the single relative_delta on frames where the cap binds"
  },
  "split": {
    "strategy": "chronological_whole_segment",
    "train_fraction": 0.70,
    "validation_fraction": 0.15
  },
  "forecast": {
    "window_minutes": 60,
    "horizon_minutes": 15,
    "support_min_pu": 0.0,
    "support_max_pu": 1.06,
    "n_bins": 106
  },
  "training": {
    "min_epochs": 8,
    "max_epochs": 40,
    "patience": 6,
    "min_delta": 0.0001,
    "batch_size": 512,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "fail_on_nonconvergence": true
  },
  "model": {
    "hidden_channels": 32,
    "layers": 4,
    "kernel_size": 3,
    "dropout": 0.10
  },
  "evaluation": {
    "primary_score": "WIS",
    "quantiles": [0.05, 0.10, 0.20, 0.30, 0.50, 0.70, 0.80, 0.90, 0.95],
    "interval_alphas": [0.10, 0.20, 0.40, 0.60]
  },
  "inference": {
    "seed": 20260726,
    "cluster_bootstrap_draws": 5000,
    "sign_flip_draws": 100000,
    "exhaustive_max_clusters": 16
  },
  "comparisons": [
    {
      "family": "ROBUSTNESS_contaminated_inputs_B4_vs_B4plain",
      "metric": "wis",
      "reference": "B4_plain",
      "challenger": "B4"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_censored_likelihood",
      "metric": "wis",
      "reference": "B4",
      "challenger": "B6"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_censored_likelihood",
      "metric": "wis",
      "reference": "B4",
      "challenger": "BT"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_censored_likelihood",
      "metric": "wis",
      "reference": "B1",
      "challenger": "B6"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_B6_vs_BT",
      "metric": "wis",
      "reference": "BT",
      "challenger": "B6"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_B6_vs_BQR",
      "metric": "wis",
      "reference": "BQR",
      "challenger": "B6"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_B6_vs_persistence",
      "metric": "wis",
      "reference": "B0_persistence",
      "challenger": "B6"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_oracle_gap",
      "metric": "wis",
      "reference": "B6",
      "challenger": "ORACLE",
      "equivalence_margin": 0.005
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_powercurve_reconstruction",
      "metric": "wis",
      "reference": "B4",
      "challenger": "B2_recon"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_powercurve_reconstruction",
      "metric": "wis",
      "reference": "B2_recon",
      "challenger": "B6"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_censored_quantile_CLQR",
      "metric": "wis",
      "reference": "BQR",
      "challenger": "CLQR"
    },
    {
      "family": "ROBUSTNESS_contaminated_inputs_censored_quantile_CLQR",
      "metric": "wis",
      "reference": "B6",
      "challenger": "CLQR"
    }
  ],
  "execution": {
    "device": "auto"
  }
}
